{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talkbh",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "5 3 * * *"
    ]
  },
  "preview_urls": true,
  "previews": {},
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
