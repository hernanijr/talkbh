---
import BaseLayout from '../layouts/BaseLayout.astro';
import { copy, site, type Language } from '../data/site';
import { getGoogleMapsUrl, getWhatsAppInvite, getMeetupStatus } from '../data/meetup';
import type { CommunityMeetup } from '../data/community-content';

const { event, lang } = Astro.props as { event: CommunityMeetup; lang: Language };
const title = event.title?.[lang] ?? 'Talk BH';
const description = event.description?.[lang] ?? '';
const homeUrl = lang === 'en' ? '/en/' : '/';
const alternateHomeUrl = lang === 'en' ? '/' : '/en/';
const slug = event.slug ?? 'talk-bh';
const eventPathPt = `/eventos/${slug}/`;
const eventPathEn = `/en/events/${slug}/`;
const domain = site.brand.domain.replace(/\/$/, '');
const canonicalUrl = `${domain}${lang === 'en' ? eventPathEn : eventPathPt}`;
const portugueseUrl = `${domain}${eventPathPt}`;
const englishUrl = `${domain}${eventPathEn}`;
const socialImageUrl = event.image ? new URL(event.image, `${domain}/`).href : `${domain}/social-card.svg`;
const eventDate = event.date ? new Date(event.date) : undefined;
if (!eventDate || Number.isNaN(eventDate.getTime())) throw new Error(`Event "${slug}" has an invalid start date.`);
const dateText = new Intl.DateTimeFormat(lang, {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Sao_Paulo',
}).format(eventDate);
const timeText = new Intl.DateTimeFormat(lang, {
  hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Sao_Paulo',
}).format(eventDate);
const endDate = event.endDate ? new Date(event.endDate) : undefined;
const endTimeText = endDate && !Number.isNaN(endDate.getTime())
  ? new Intl.DateTimeFormat(lang, { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Sao_Paulo' }).format(endDate)
  : undefined;
const meetupStatus = getMeetupStatus(event);
const isCancelled = meetupStatus === 'cancelled';
const isPast = meetupStatus === 'past';
const mapsUrl = getGoogleMapsUrl(event.mapsUrl);
const wa = getWhatsAppInvite(site.social.whatsapp);
const joinUrl = wa ?? site.social.instagram;
const formattedPrice = event.entryPrice === 0
  ? (lang === 'en' ? 'Free admission' : 'Entrada gratuita')
  : event.entryPrice === undefined
    ? undefined
    : new Intl.NumberFormat(lang, { style: 'currency', currency: 'BRL' }).format(event.entryPrice);
const pageTitle = lang === 'en'
  ? `${title} | Talk BH — English meetup in Belo Horizonte`
  : `${title} | Talk BH — Encontro em Belo Horizonte`;
const pageCopy = lang === 'en'
  ? {
      back: 'Back to Talk BH',
      eyebrow: isCancelled ? 'CANCELLED MEETUP' : isPast ? 'PAST MEETUP' : 'TALK BH MEETUP',
      when: 'DATE & TIME',
      venue: 'VENUE',
      admission: 'ADMISSION',
      freeNote: 'Participation is free. Each attendee pays only for their own food and drinks at the venue.',
      noSignup: 'No registration or reservation required.',
      directions: 'Get directions',
      join: 'Join the WhatsApp community',
      updates: 'Follow the community for future meetups and updates.',
      cancelled: 'This meetup has been cancelled. Follow the community for future announcements.',
      past: 'This meetup has taken place. Join the community to hear about future dates.',
      home: 'Explore Talk BH',
      time: 'Time',
      ends: 'Ends',
    }
  : {
      back: 'Voltar ao Talk BH',
      eyebrow: isCancelled ? 'ENCONTRO CANCELADO' : isPast ? 'ENCONTRO REALIZADO' : 'ENCONTRO TALK BH',
      when: 'DATA E HORÁRIO',
      venue: 'LOCAL',
      admission: 'ENTRADA',
      freeNote: 'A participação é gratuita. Cada pessoa paga apenas pelo que consumir no estabelecimento.',
      noSignup: 'Não precisa de inscrição ou reserva.',
      directions: 'Como chegar',
      join: 'Entrar na comunidade do WhatsApp',
      updates: 'Acompanhe a comunidade para saber dos próximos encontros e novidades.',
      cancelled: 'Este encontro foi cancelado. Acompanhe a comunidade para os próximos anúncios.',
      past: 'Este encontro já aconteceu. Entre na comunidade para saber as próximas datas.',
      home: 'Conheça o Talk BH',
      time: 'Horário',
      ends: 'Término',
    };
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={description}
  event={event}
  canonicalUrl={canonicalUrl}
  portugueseUrl={portugueseUrl}
  englishUrl={englishUrl}
  socialImageUrl={socialImageUrl}
  openGraphType="article"
>
  <main id="main" class="min-h-screen bg-paper">
    <header class="border-b border-black/10 bg-paper">
      <nav class="wrap flex min-h-[76px] items-center justify-between gap-4" aria-label={lang === 'en' ? 'Event navigation' : 'Navegação do evento'}>
        <a href={homeUrl} class="display text-2xl font-bold tracking-[-.08em] text-ink no-underline">talk<span class="text-talk-text">.</span>bh</a>
        <div class="flex items-center gap-3">
          <a href={alternateHomeUrl} class="border border-talk/40 bg-white px-3 py-2 text-xs font-bold uppercase text-talk-text no-underline">{lang === 'en' ? 'PT' : 'EN'} ↗</a>
          <a href={homeUrl} class="text-sm font-semibold text-ink underline underline-offset-4">{pageCopy.back}</a>
        </div>
      </nav>
    </header>

    <article class="wrap grid gap-10 py-12 md:py-20 lg:grid-cols-[1.1fr_.9fr]">
      <div>
        <p class="mono mb-6 flex items-center gap-3 text-xs font-semibold uppercase tracking-[.12em] text-talk-text">
          <span class="h-2 w-2 bg-talk"></span>{pageCopy.eyebrow}
        </p>
        <h1 class="display max-w-3xl text-5xl font-bold leading-[.96] md:text-7xl">{title}</h1>
        {description && <p class="mt-7 max-w-2xl text-lg leading-[1.75] text-black/70">{description}</p>}

        <figure class="mt-10 overflow-hidden border border-black/10 bg-white">
          <img
            src={event.image ?? '/social-card.svg'}
            alt={lang === 'en' ? `Event artwork for ${title}` : `Arte de divulgação de ${title}`}
            width="1200"
            height="630"
            class="block aspect-[16/9] w-full object-cover"
            fetchpriority="high"
            decoding="async"
          />
        </figure>

        <div class="mt-10 border-t border-black/15 pt-7">
          <h2 class="display text-2xl font-semibold">{lang === 'en' ? 'About this meetup' : 'Sobre este encontro'}</h2>
          <p class="mt-3 max-w-2xl text-base leading-[1.8] text-black/70">
            {lang === 'en'
              ? 'Talk BH brings people together in Belo Horizonte to practice English, meet new people and have good conversations in a relaxed social setting.'
              : 'O Talk BH reúne pessoas em Belo Horizonte para praticar inglês, conhecer gente nova e ter boas conversas em um ambiente social descontraído.'}
          </p>
        </div>
      </div>

      <aside class="self-start border border-black/15 bg-white p-6 shadow-sm md:p-8" aria-label={lang === 'en' ? 'Meetup details' : 'Detalhes do encontro'}>
        <p class="mono text-xs font-semibold uppercase tracking-[.12em] text-talk-text">{pageCopy.when}</p>
        <p class="display mt-3 text-2xl font-semibold capitalize">{dateText}</p>
        <dl class="mt-7 space-y-5 border-t border-black/10 pt-6">
          <div>
            <dt class="mono text-xs uppercase text-black/55">{pageCopy.time}</dt>
            <dd class="display mt-1 text-3xl font-semibold">{timeText}</dd>
          </div>
          {endTimeText && <div>
            <dt class="mono text-xs uppercase text-black/55">{pageCopy.ends}</dt>
            <dd class="mt-1 text-lg font-semibold">{endTimeText}</dd>
          </div>}
          <div>
            <dt class="mono text-xs uppercase text-black/55">{pageCopy.venue}</dt>
            <dd class="mt-2 text-lg font-semibold">{event.venue}</dd>
            <dd class="mt-1 text-sm leading-relaxed text-black/65">{event.address}</dd>
            <dd class="mt-1 text-sm text-black/55">{event.city}</dd>
          </div>
          {formattedPrice && <div>
            <dt class="mono text-xs uppercase text-black/55">{pageCopy.admission}</dt>
            <dd class="mt-1 text-lg font-semibold">{formattedPrice}</dd>
            {event.entryPrice === 0 && <dd class="mt-1 text-sm leading-relaxed text-black/60">{pageCopy.freeNote}</dd>}
          </div>}
        </dl>
        {mapsUrl && <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex min-h-12 w-full items-center justify-center gap-3 border border-black/20 px-5 py-3 text-sm font-bold text-ink no-underline transition hover:border-talk hover:text-talk-text">{pageCopy.directions} ↗</a>}
        <div class="mt-4 border-t border-black/10 pt-5">
          {isCancelled
            ? <p class="text-sm leading-relaxed text-talk-text">{pageCopy.cancelled}</p>
            : isPast
              ? <p class="text-sm leading-relaxed text-black/65">{pageCopy.past}</p>
              : <p class="text-sm leading-relaxed text-black/65">{pageCopy.noSignup}</p>}
          <a href={joinUrl} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex min-h-12 w-full items-center justify-center gap-3 bg-talk px-5 py-3 text-center text-sm font-bold text-white no-underline transition hover:bg-ink">{pageCopy.join} ↗</a>
          <p class="mt-4 text-xs leading-relaxed text-black/55">{pageCopy.updates}</p>
        </div>
      </aside>
    </article>
  </main>

  <footer class="bg-ink py-8 text-white">
    <div class="wrap flex flex-wrap items-center justify-between gap-4 text-xs text-white/65">
      <a href={homeUrl} class="font-semibold text-white no-underline">{pageCopy.home} ↗</a>
      <span>© {new Date().getFullYear()} Talk BH · Belo Horizonte, MG</span>
      <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="text-white underline underline-offset-4">Instagram ↗</a>
    </div>
  </footer>
</BaseLayout>
